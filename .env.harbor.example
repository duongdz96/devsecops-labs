# Copy to .env.harbor and replace every CHANGE_ME value before generation.
HARBOR_HOSTNAME=host.docker.internal
HARBOR_HTTP_PORT=8083
HARBOR_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
HARBOR_DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
# Harbor installer requires an absolute Linux path for bind-mounted data.
HARBOR_DATA_DIR=/home/duongnb/devsecops-harbor/data
