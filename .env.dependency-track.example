# Dependency-Track 4.14.2, pinned by manifest digest for reproducible rebuilds.
DTRACK_API_IMAGE=dependencytrack/apiserver@sha256:1ba4f004e1ec4800ec0e0175b0f1cf361a68f6ac3db9274a32d0a47cd4038f51
DTRACK_FRONTEND_IMAGE=dependencytrack/frontend@sha256:00560b57a6cfdec3c02a6e02be80fce97029241a9c653e8b83c0b670dff1f3ca
DTRACK_POSTGRES_IMAGE=postgres:16-alpine
DTRACK_API_PORT=8080
DTRACK_FRONTEND_PORT=8081
DTRACK_POSTGRES_USER=dtrack
DTRACK_POSTGRES_PASSWORD=CHANGE_ME
DTRACK_POSTGRES_DB=dtrack
# Local UI bootstrap credential; generated into gitignored .env.dependency-track.
DTRACK_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
DTRACK_POSTGRES_DIR=./dependency-track/postgres
DTRACK_API_DATA_DIR=./dependency-track/apiserver
# Generate once before first boot. Changing this value later invalidates encrypted data and API keys.
DTRACK_ALPINE_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_HEX
DTRACK_JAVA_OPTIONS=-Xmx2048m
