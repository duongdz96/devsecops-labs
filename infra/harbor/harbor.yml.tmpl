# Harbor 2.11.1 local lab configuration template.
# Generate infra/harbor/harbor.yml with scripts/New-HarborConfig.ps1.
# Do not pass this template directly to Harbor prepare/install.

hostname: '__HARBOR_HOSTNAME__'

http:
  port: __HARBOR_HTTP_PORT__

# HTTPS is intentionally disabled for this local-only lab.
# Docker Desktop, GitLab DinD, and k3d must explicitly trust this HTTP registry.

harbor_admin_password: '__HARBOR_ADMIN_PASSWORD__'

database:
  password: '__HARBOR_DB_PASSWORD__'
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

# Must resolve to an absolute Linux path in the WSL runtime.
data_volume: __HARBOR_DATA_DIR__

trivy:
  ignore_unfixed: false
  skip_update: false
  skip_java_db_update: false
  offline_scan: false
  security_check: vuln
  insecure: false
  timeout: 5m0s

jobservice:
  max_job_workers: 5
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: info
  local:
    rotate_count: 10
    rotate_size: 100M
    location: /var/log/harbor

_version: 2.11.0

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
